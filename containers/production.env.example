# Linux host, local Docker daemon. All directories must already exist.
FACTORY_UID=1000
FACTORY_GID=1000
FACTORY_DOCKER_GID=999
FACTORY_DATA_DIR=/srv/software-factory/data
FACTORY_WORKSPACE=/srv/software-factory/workspace
FACTORY_TOKEN_FILE=/srv/software-factory/http-token
FACTORY_PORT=4317
FACTORY_CALLER_ID=local-operator
FACTORY_CONTROLLER_IMAGE=software-factory-controller:issue-19
